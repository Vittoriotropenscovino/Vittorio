# API Keys
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/football_predictions
REDIS_URL=redis://localhost:6379/0
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token
INFLUXDB_ORG=football_org
INFLUXDB_BUCKET=predictions

# Application Configuration
LOG_LEVEL=INFO
MODEL_VERSION=3.0-auto
SAVE_RAW_DATA=true
ENABLE_ML=false

# Scheduler Configuration
ENABLE_SCHEDULER=true
H24_ANALYSIS_TIME=10:00
CHECK_INTERVAL_MINUTES=10

# Rate Limiting
FOOTBALL_DATA_RATE_LIMIT=10
API_FOOTBALL_DAILY_LIMIT=100
API_FOOTBALL_MINUTE_LIMIT=30

# Scraping Configuration
SCRAPING_TIMEOUT=15
SELENIUM_HEADLESS=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Model Configuration
ENSEMBLE_WEIGHTS=0.4,0.4,0.2
CONFIDENCE_THRESHOLD=0.50
VALUE_BET_THRESHOLD=0.05

# Storage Paths
PREDICTIONS_PATH=/app/predictions
LOGS_PATH=/app/logs
MODELS_PATH=/app/models_ml

# AWS/Cloud Storage (optional)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# S3_BUCKET=football-predictions-logs

# Monitoring (optional)
# SENTRY_DSN=your_sentry_dsn
